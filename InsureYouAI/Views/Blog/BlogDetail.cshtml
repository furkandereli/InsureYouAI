@{
    Layout = null;
}

<!doctype html>
<html class="no-js" lang="zxx">
    @await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    <header class="header-area header-three">
        @await Component.InvokeAsync("_DefaultHeaderComponentPartial")
        @await Component.InvokeAsync("_DefaultHeaderContactComponentPartial")
        @await Component.InvokeAsync("_DefaultNavbarComponentPartial")
    </header>
    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")
    <main>       
        <section class="inner-blog b-details-p pt-120 pb-120">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8">
                        <div class="blog-details-wrap">
                            @await Component.InvokeAsync("_BlogDetailContentComponentPartial")
                            @await Component.InvokeAsync("_BlogDetailNextAndPrevPostComponentPartial")
                            @await Component.InvokeAsync("_BlogDetailAboutAuthorComponentPartial")
                            @await Component.InvokeAsync("_BlogDetailCommentListComponentPartial")
                            
                            <div id="comments" class="comments-area  mt-45">
                                <div id="respond" class="comment-respond">
                                    <h3 id="reply-title" class="comment-reply-title">Leave a Reply <small><a rel="nofollow" id="cancel-comment-reply-link" href="/finco/?p=2112#respond" style="display:none;">Cancel reply</a></small></h3>
                                    <form action="http://wordpress.zcube.in/finco/wp-comments-post.php" method="post" id="commentform" class="comment-form" novalidate="">
                                        <p class="comment-notes"><span id="email-notes">Your email address will not be published.</span> Required fields are marked <span class="required">*</span></p>
                                        <p class="comment-field"><i class="fas fa-user"></i><input id="author" placeholder="Your Name" name="author" type="text"></p>
                                        <p class="comment-field"><i class="fas fa-envelope"></i><input id="email" placeholder="your-real-email@example.com" name="email" type="text"></p>
                                        <p class="comment-field"><i class="fas fa-globe"></i><input id="url" name="url" placeholder="http://your-site-name.com" type="text"> </p>
                                        <p class="comment-form-comment"><label for="comment">Comment</label> <textarea id="comment" name="comment" cols="45" rows="8" maxlength="65525" required="required"></textarea></p>
                                        <p class="form-submit">
                                            <input name="submit" type="submit" id="submit" class="submit" value="Post Comment"> <input type="hidden" name="comment_post_ID" value="2112" id="comment_post_ID">
                                            <input type="hidden" name="comment_parent" id="comment_parent" value="0">
                                        </p>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-4">
                        <aside class="sidebar-widget">
                            @await Html.PartialAsync("~/Views/Blog/GetBlog.cshtml")
                            @await Component.InvokeAsync("_BlogListSocialMediaComponentPartial")
                            @await Component.InvokeAsync("_BlogListCategoriesComponentPartial")
                            @await Component.InvokeAsync("_BlogListLast3RecentBlogComponentPartial")
                            @await Component.InvokeAsync("_BlogListTagComponentPartial")
                        </aside>
                    </div>
                </div>
            </div>
        </section>
        @await Html.PartialAsync("~/Views/Default/SubscribeEmail.cshtml")
    </main>
    @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")
</body>
</html>